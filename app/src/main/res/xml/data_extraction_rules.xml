<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ uses this file instead of fullBackupContent. Ward excludes all of its local
  state from both cloud backup and device-to-device transfer: message history is stored in
  a plaintext Room database, the app-lock verifier lives in shared preferences, and account
  passwords are encrypted with a keystore key that is not transferable.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
