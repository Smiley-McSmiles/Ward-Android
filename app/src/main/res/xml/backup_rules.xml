<?xml version="1.0" encoding="utf-8"?>
<!--
  Ward deliberately keeps its local state off cloud backups. The Room database contains
  message history in plaintext, shared preferences contain the app-lock verifier, and the
  keystore-wrapped account passwords cannot be restored on another device anyway. Backing
  any of it up would either leak conversations or leave an account that can no longer sign
  in. This file covers Android 11 and older; data_extraction_rules.xml covers Android 12+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
